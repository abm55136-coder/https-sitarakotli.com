# Environment configuration template (do not store secret keys here)
# Server-side only secrets (never expose in frontend or prefix with VITE_)
GEMINI_API_KEY=
FIREBASE_WEB_API_KEY=
ADMIN_PASSCODE=
RESEND_API_KEY=
SECURITY_FROM_EMAIL=

# Client Firebase Web configuration (add rotated key to .env.local or deployment Secrets)
VITE_FIREBASE_API_KEY=

# Server runtime
PORT=3000
NODE_ENV=development
